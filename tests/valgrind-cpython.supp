# CPython 3.13 runtime cached/interned Unicode allocations observed with
# PYTHONMALLOC=malloc. Only definite leaks with these precise runtime call
# chains are suppressed. No DML allocator, ID/record buffer, capsule, or direct
# decode_datum/decode_object Unicode-return chain matches these patterns.
# See coverage-exclusions.md (memory-check accounting) and the runtime-only
# DML_MEMORY_BASELINE comparison. Re-evaluate with another CPython build.
{
  cpython-marshalled-unicode
  Memcheck:Leak
  match-leak-kinds: definite
  fun:malloc
  fun:PyUnicode_New*
  fun:_PyUnicode_FromUCS1*
  fun:r_object
}
{
  cpython-module-dictionary-keys
  Memcheck:Leak
  match-leak-kinds: definite
  fun:malloc
  fun:PyUnicode_New*
  fun:unicode_decode_utf8
  fun:PyDict_SetItemString
}
{
  cpython-interned-runtime-names
  Memcheck:Leak
  match-leak-kinds: definite
  fun:malloc
  fun:PyUnicode_New*
  fun:unicode_decode_utf8
  fun:PyUnicode_InternFromString
}
{
  cpython-type-ready-names
  Memcheck:Leak
  match-leak-kinds: definite
  fun:malloc
  fun:PyUnicode_New*
  fun:unicode_decode_utf8
  fun:type_ready
}
{
  cpython-descriptor-names
  Memcheck:Leak
  match-leak-kinds: definite
  fun:malloc
  fun:PyUnicode_New*
  fun:unicode_decode_utf8
  fun:descr_new
}
